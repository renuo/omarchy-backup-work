# Settings of backup-work.service. systemd reads this file as it is: one
# KEY=value per line, no shell, no ~ or $HOME. "Back up now" in the panel
# tries them out.

# Where the backups go: your Renuo Google Drive, through the rclone plugin's
# gdrive remote and its login.
RESTIC_REPOSITORY=rclone:gdrive:Backups/work

# The folders to back up, separated by spaces; each must exist. Only what is
# not in Google Drive already: documents shared with colleagues live there
# and need no backup.
RESTIC_BACKUP_PATHS=@HOME@/Work @HOME@/Documents @HOME@/Pictures

# More options for restic backup. What to leave out is in excludes.txt next
# to this file. https://restic.readthedocs.io/en/stable/040_backup.html
RESTIC_BACKUP_ARGS=--one-file-system --exclude-caches

# Which snapshots to keep: a day of hours, two weeks of days, two months of
# weeks, a year of months. The others are forgotten after each backup.
# https://restic.readthedocs.io/en/stable/060_forget.html
RESTIC_FORGET_ARGS=--keep-hourly 24 --keep-daily 14 --keep-weekly 8 --keep-monthly 12

# auto, max or off.
#RESTIC_COMPRESSION=auto
